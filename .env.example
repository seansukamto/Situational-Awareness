OPENAI_INPUT_COST_PER_1M_USD=0
OPENAI_OUTPUT_COST_PER_1M_USD=0

# Optional local Ollama-compatible provider. A model name enables the mode.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
